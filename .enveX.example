# Copy to .env and fill in. Never commit .env.
DB_PASSWORD=change_me

# Base64 of at least 32 random bytes. Generate with:
#   Linux/WSL/macOS: openssl rand -base64 32
#   PowerShell:      $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
JWT_TTL_MINUTES=60

# First admin, created at startup only if no admin exists (password: 10+ characters).
ADMIN_EMAIL=admin@classos.local
ADMIN_PASSWORD=change_me_please

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Timetable solver (C++ service)
SOLVER_URL=http://localhost:7070
SOLVER_TIME_LIMIT_MS=10000

# Sample department for demos (fictional data). Never enable on a real server.
DEV_SEED_ENABLED=false
DEV_SEED_PASSWORD=change_me_please

# Attendance (Milestone 3). Separate from JWT_SECRET; generate the same way.
ATTENDANCE_SECRET=
ATTENDANCE_WINDOW_SECONDS=10
ATTENDANCE_SESSION_MINUTES=15
# Campus Wi-Fi ranges, comma-separated (e.g. 10.20.0.0/16). Empty = no network check.
ATTENDANCE_ALLOWED_CIDRS=
ATTENDANCE_MINIMUM_PERCENT=75

# File storage (Milestone 4). Relative paths are relative to where the backend starts.
STORAGE_DIR=./data/files
MAX_UPLOAD_MB=20
# Grading queue defaults (teachers can override per view)
GRADING_AGING_PER_HOUR=0.25
GRADING_QUANTUM=3

# Milestone 5: tuning and limits
DB_POOL_SIZE=20
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_ADDRESS=30
